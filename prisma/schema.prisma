generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  admin
  manager
}

enum OrderPriority {
  low
  medium
  high
}

enum OrderSource {
  manual
  api
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  fullName String?
  avatar   String?

  magicLinks    MagicLink[]
  memberships   WorkspaceMember[]
  createdOrders Order[]           @relation("OrderCreator")
  responsibleIn Order[]           @relation("OrderResponsibles")
  chatMessages  ChatMessage[]

  @@map("users")
}

model WorkspaceMember {
  id      String        @id @default(uuid())
  role    WorkspaceRole
  isFired Boolean       @default(false)

  user   User   @relation(fields: [userId], references: [id])
  userId String

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

model MagicLink {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("magic_links")
}

model Workspace {
  id                    String  @id @default(uuid())
  title                 String
  apiKey                String? @unique
  lastAssignedManagerId String? // User id of employee the last order was assigned to
  defaultCountryCode    String?
  currency              String? @default("USD")

  members   WorkspaceMember[]
  columns   Column[]
  customers Customer[]
  services  Service[]

  @@map("workspaces")
}

model Service {
  id         String  @id @default(uuid())
  title      String
  basePrice  Float
  isArchived Boolean @default(false)

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  orderItems OrderItem[]

  @@map("services")
}

model Column {
  id       String  @id @default(uuid())
  title    String
  position Int     @default(1)
  // There must always be only one system column for Backlog
  isSystem Boolean @default(false)

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  orders Order[]

  @@map("columns")
}

model Order {
  id          String        @id @default(uuid())
  title       String
  description String?
  createdAt   DateTime      @default(now())
  deadline    String?
  priority    OrderPriority @default(medium)
  source      OrderSource   @default(manual)
  isArchived  Boolean       @default(false)
  updatedAt   DateTime      @default(now())
  position    String?

  creator   User?   @relation("OrderCreator", fields: [creatorId], references: [id])
  creatorId String?

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  column   Column @relation(fields: [columnId], references: [id])
  columnId String

  responsibles User[]        @relation("OrderResponsibles")
  links        OrderLink[]
  items        OrderItem[]
  messages     ChatMessage[]

  @@map("orders")
}

model ChatMessage {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  @@map("chat_messages")
}

model OrderItem {
  id       String  @id @default(uuid())
  isDone   Boolean @default(false)
  price    Float
  quantity Int

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  service   Service @relation(fields: [serviceId], references: [id])
  serviceId String

  @@map("order_items")
}

model OrderLink {
  id    String @id @default(uuid())
  title String
  url   String

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  @@map("order_links")
}

model Customer {
  id           String  @id @default(uuid())
  fullName     String
  phone        String
  countryCode  String
  city         String
  region       String?
  addressLine1 String?
  addressLine2 String?
  postalCode   String?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  orders Order[]

  @@unique([phone, workspaceId])
  @@map("customers")
}
